@inject NavigationManager Navigation

@code {
    // Página de cadastro aberta sem login de administrador: manda para o login e volta depois.
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"admin/entrar?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
