@page "/caminhoes"
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Caminhões</PageTitle>

<div class="d-flex flex-column gap-4">
    <div>
        <h1 class="mb-1">Caminhões</h1>
        <p class="text-secondary mb-0">Cadastro dos veículos com as medidas internas do baú, em centímetros.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Cadastrar caminhão</h2>

                    <EditForm Model="truckForm" OnValidSubmit="HandleCreateTruckAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <InputText @bind-Value="truckForm.Name" class="form-control" />
                            <ValidationMessage For="() => truckForm.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Placa</label>
                            <InputText @bind-Value="truckForm.Plate" class="form-control" maxlength="10" />
                            <ValidationMessage For="() => truckForm.Plate" />
                        </div>

                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Comprimento (cm)</label>
                                <InputNumber @bind-Value="truckForm.LengthCm" class="form-control" />
                                <ValidationMessage For="() => truckForm.LengthCm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Largura (cm)</label>
                                <InputNumber @bind-Value="truckForm.WidthCm" class="form-control" />
                                <ValidationMessage For="() => truckForm.WidthCm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Altura (cm)</label>
                                <InputNumber @bind-Value="truckForm.HeightCm" class="form-control" />
                                <ValidationMessage For="() => truckForm.HeightCm" />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Capacidade de carga (kg)</label>
                            <InputNumber @bind-Value="truckForm.MaxLoadKg" class="form-control" />
                            <ValidationMessage For="() => truckForm.MaxLoadKg" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Motorista (opcional)</label>
                            <InputSelect @bind-Value="truckForm.DriverId" class="form-select">
                                <option value="">Sem motorista</option>
                                @foreach (var driver in drivers.Where(item => item.TruckPlate is null))
                                {
                                    <option value="@driver.Id">@driver.Name</option>
                                }
                            </InputSelect>
                            @if (!drivers.Any())
                            {
                                <div class="form-text">Nenhum motorista cadastrado. <a href="motoristas">Cadastrar motorista</a></div>
                            }
                        </div>

                        <button type="submit" class="btn btn-primary mt-3" disabled="@isSubmitting">
                            @(isSubmitting ? "Salvando..." : "Salvar caminhão")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Caminhões cadastrados</h2>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadTrucksAsync">Atualizar</button>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-secondary">Consultando a API de cubagem...</div>
                    }
                    else if (!trucks.Any())
                    {
                        <div class="text-secondary">Nenhum caminhão cadastrado ainda.</div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Placa</th>
                                    <th>Baú (C x L x A)</th>
                                    <th>Volume</th>
                                    <th>Capacidade</th>
                                    <th>Motorista</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var truck in trucks)
                                {
                                    <tr>
                                        <td>@truck.Name</td>
                                        <td>@truck.Plate</td>
                                        <td>@truck.LengthCm x @truck.WidthCm x @truck.HeightCm cm</td>
                                        <td>@truck.TruckVolumeM3.ToString("0.###") m³</td>
                                        <td>@truck.MaxLoadKg.ToString("N0") kg</td>
                                        <td>
                                            @* Mostra os motoristas livres e o atual deste caminhão. *@
                                            <select class="form-select form-select-sm" value="@(truck.DriverId?.ToString() ?? "")"
                                                    @onchange="e => SetDriverAsync(truck, e.Value?.ToString())">
                                                <option value="">Sem motorista</option>
                                                @foreach (var driver in drivers.Where(item => item.TruckPlate is null || item.Id == truck.DriverId))
                                                {
                                                    <option value="@driver.Id">@driver.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => DeleteTruckAsync(truck)">
                                                Excluir
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<TruckDto> trucks = [];
    private readonly List<DriverDto> drivers = [];
    private readonly TruckForm truckForm = new();
    private bool isLoading;
    private bool isSubmitting;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTrucksAsync();
    }

    private async Task LoadTrucksAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var truckList = await http.GetFromJsonAsync<List<TruckDto>>("/api/trucks/");
            var driverList = await http.GetFromJsonAsync<List<DriverDto>>("/api/drivers/");
            trucks.Clear();
            trucks.AddRange(truckList ?? []);
            drivers.Clear();
            drivers.AddRange(driverList ?? []);
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreateTruckAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var payload = new
            {
                Name = truckForm.Name,
                Plate = truckForm.Plate,
                LengthCm = truckForm.LengthCm,
                WidthCm = truckForm.WidthCm,
                HeightCm = truckForm.HeightCm,
                MaxLoadKg = truckForm.MaxLoadKg,
                DriverId = truckForm.DriverId
            };

            var response = await http.PostAsJsonAsync("/api/trucks/", payload);
            await ApiException.EnsureSuccessAsync(response);

            successMessage = $"Caminhão {truckForm.Name} cadastrado.";
            truckForm.Reset();
            await LoadTrucksAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteTruckAsync(TruckDto truck)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Excluir o caminhão {truck.Name} e toda a carga dele?"))
        {
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var response = await http.DeleteAsync($"/api/trucks/{truck.Id}");
            await ApiException.EnsureSuccessAsync(response);

            await LoadTrucksAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }
    }

    // driverIdText vem do <select>: "" quer dizer sem motorista.
    private async Task SetDriverAsync(TruckDto truck, string? driverIdText)
    {
        errorMessage = null;
        successMessage = null;
        int? driverId = int.TryParse(driverIdText, out var id) ? id : null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var response = await http.PutAsJsonAsync($"/api/trucks/{truck.Id}/driver", new { DriverId = driverId });
            await ApiException.EnsureSuccessAsync(response);

            successMessage = driverId is null
                ? $"Caminhão {truck.Name} ficou sem motorista."
                : $"Motorista do caminhão {truck.Name} atualizado.";
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }

        // Recarrega sempre, para a lista voltar ao valor certo se der erro.
        await LoadTrucksAsync();
    }

    private sealed class TruckForm
    {
        [Required(ErrorMessage = "Informe o nome.")]
        [StringLength(120, ErrorMessage = "O nome pode ter até 120 caracteres.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Informe a placa.")]
        [StringLength(10, ErrorMessage = "A placa pode ter até 10 caracteres.")]
        public string? Plate { get; set; }

        [Range(1, 99_999, ErrorMessage = "Use um valor entre 1 e 99.999 cm.")]
        public decimal LengthCm { get; set; } = 500m;

        [Range(1, 99_999, ErrorMessage = "Use um valor entre 1 e 99.999 cm.")]
        public decimal WidthCm { get; set; } = 220m;

        [Range(1, 99_999, ErrorMessage = "Use um valor entre 1 e 99.999 cm.")]
        public decimal HeightCm { get; set; } = 240m;

        [Range(1, 99_999, ErrorMessage = "Use um valor entre 1 e 99.999 kg.")]
        public decimal MaxLoadKg { get; set; } = 4000m;

        public int? DriverId { get; set; }

        public void Reset()
        {
            Name = string.Empty;
            Plate = string.Empty;
            LengthCm = 500m;
            WidthCm = 220m;
            HeightCm = 240m;
            MaxLoadKg = 4000m;
            DriverId = null;
        }
    }
}
