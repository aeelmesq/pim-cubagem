@page "/admin/entrar"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Entrar como administrador</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h1 class="h4 mb-1">Acesso do administrador</h1>
                <p class="text-secondary">Entre para cadastrar caminhões, motoristas e cargas.</p>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <EditForm Model="Input" FormName="admin-login" method="post" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="admin-username">Usuário</label>
                        <InputText id="admin-username" @bind-Value="Input.Username" class="form-control" autocomplete="username" />
                        <ValidationMessage For="() => Input.Username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="admin-password">Senha</label>
                        <InputText id="admin-password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </EditForm>

                <p class="text-secondary small mt-3 mb-0">
                    É motorista? Use a <a href="entrar">área do motorista</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginForm Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? errorMessage;

    // Só volta para endereços deste site (evita redirecionar para outro site depois do login).
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/";

    protected override void OnInitialized()
    {
        Input ??= new LoginForm();

        // Já está logado como administrador: vai direto para o sistema.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.IsInRole(AdminSession.Role))
        {
            Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
        }
    }

    private async Task LoginAsync()
    {
        AdminLoginResponseDto? login;
        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            using var request = new HttpRequestMessage(HttpMethod.Post, "/api/auth/admin/login")
            {
                Content = JsonContent.Create(new { Input.Username, Input.Password })
            };

            // A API limita as tentativas de login por IP. Sem isto, todo mundo pareceria vir do IP do Blazor.
            var clientIp = HttpContext.Connection.RemoteIpAddress?.ToString();
            if (clientIp is not null)
            {
                request.Headers.Add("X-Forwarded-For", clientIp);
            }

            using var response = await http.SendAsync(request);
            if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                errorMessage = "Muitas tentativas de login. Espere um minuto e tente de novo.";
                return;
            }

            await ApiException.EnsureSuccessAsync(response);
            login = await response.Content.ReadFromJsonAsync<AdminLoginResponseDto>();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
            return;
        }

        if (login is null || string.IsNullOrEmpty(login.Username))
        {
            errorMessage = "A API não devolveu o login.";
            return;
        }

        var identity = new ClaimsIdentity(
            new[] { new Claim(ClaimTypes.Name, login.Username), new Claim(ClaimTypes.Role, AdminSession.Role) },
            CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
    }

    private sealed class LoginForm
    {
        [Required(ErrorMessage = "Informe o usuário.")]
        public string? Username { get; set; }

        [Required(ErrorMessage = "Informe a senha.")]
        public string? Password { get; set; }
    }
}
