@page "/"
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>CubagemCaminhao</PageTitle>

<div class="d-flex flex-column gap-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="mb-1">Cubagem de caminhões</h1>
            <p class="text-secondary mb-0">Cadastro de veículos e carga com cálculo automático de ocupação.</p>
        </div>
        <div class="badge bg-primary-subtle text-primary-emphasis px-3 py-2 rounded-pill fs-6">
            @(isLoading ? "Carregando..." : $"{trucks.Count} caminhões")
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="h5 mb-3">Resumo operacional</h2>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Total de caminhões</div>
                        <div class="fs-3 fw-bold">@trucks.Count</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Volume total</div>
                        <div class="fs-3 fw-bold">@GetTotalVolumeM3().ToString("0.##") m³</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Ocupação média</div>
                        <div class="fs-3 fw-bold">@GetAverageOccupancy().ToString("0.##")%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Caminhões cadastrados</h2>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadTrucksAsync">Atualizar</button>
            </div>

            @if (isLoading)
            {
                <div class="text-secondary">Consultando a API de cubagem...</div>
            }
            else if (!trucks.Any())
            {
                <div class="text-secondary">
                    Nenhum caminhão cadastrado ainda. <a href="caminhoes">Cadastrar caminhão</a>
                </div>
            }
            else
            {
                <div class="accordion">
                    @foreach (var truck in trucks)
                    {
                        var cargoForm = GetCargoForm(truck.Id);
                        var isOpen = openTruckIds.Contains(truck.Id);

                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button @(isOpen ? "" : "collapsed")" type="button" @onclick="() => ToggleTruck(truck.Id)">
                                    <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                        <span>
                                            <strong>@truck.Name</strong>
                                            <span class="text-muted ms-2">@truck.Plate · @(truck.DriverName ?? "sem motorista")</span>
                                        </span>
                                        <span class="badge @GetStatusBadgeClass(truck.Status)">
                                            @truck.Status · @truck.OccupancyPercent.ToString("0.0")% ocupado
                                        </span>
                                    </div>
                                </button>
                            </h3>

                            @if (isOpen)
                            {
                                <div class="accordion-body">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-3">
                                            <div class="small text-muted">Baú (C x L x A)</div>
                                            <div>@truck.LengthCm x @truck.WidthCm x @truck.HeightCm cm</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="small text-muted">Volume da carga / do baú</div>
                                            <div>@truck.CargoVolumeM3.ToString("0.###") / @truck.TruckVolumeM3.ToString("0.###") m³</div>
                                            <div class="small text-muted">Útil (85%): @truck.UsableVolumeM3.ToString("0.###") m³</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="small text-muted">Peso da carga / capacidade</div>
                                            <div>@truck.TotalWeightKg.ToString("N0") / @truck.MaxLoadKg.ToString("N0") kg</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="small text-muted">Peso para frete</div>
                                            <div>@truck.FreightWeightKg.ToString("N0") kg</div>
                                            <div class="small text-muted">Peso cubado: @truck.CubedWeightKg.ToString("N0") kg</div>
                                        </div>
                                    </div>

                                    <div class="card bg-light-subtle border-0 mb-3">
                                        <div class="card-body">
                                            <h4 class="h6">Adicionar item à carga</h4>
                                            <EditForm Model="cargoForm" OnValidSubmit="() => HandleCreateCargoAsync(truck.Id)">
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-4">
                                                        <label class="form-label">Nome</label>
                                                        <InputText @bind-Value="cargoForm.Name" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Comp. (cm)</label>
                                                        <InputNumber @bind-Value="cargoForm.LengthCm" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Larg. (cm)</label>
                                                        <InputNumber @bind-Value="cargoForm.WidthCm" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Alt. (cm)</label>
                                                        <InputNumber @bind-Value="cargoForm.HeightCm" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Peso (kg/un.)</label>
                                                        <InputNumber @bind-Value="cargoForm.WeightKg" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Qtd.</label>
                                                        <InputNumber @bind-Value="cargoForm.Quantity" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2 d-grid">
                                                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">Adicionar</button>
                                                    </div>
                                                </div>
                                            </EditForm>
                                        </div>
                                    </div>

                                    @if (truck.CargoItems.Any())
                                    {
                                        <table class="table table-sm align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Item</th>
                                                    <th>Dimensões</th>
                                                    <th>Qtd.</th>
                                                    <th>Volume</th>
                                                    <th>Peso</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cargo in truck.CargoItems)
                                                {
                                                    <tr>
                                                        <td>@cargo.Name</td>
                                                        <td>@cargo.LengthCm x @cargo.WidthCm x @cargo.HeightCm cm</td>
                                                        <td>@cargo.Quantity</td>
                                                        <td>@cargo.TotalVolumeM3.ToString("0.###") m³</td>
                                                        <td>@cargo.TotalWeightKg.ToString("N0") kg (@cargo.WeightKg.ToString("0.###") kg/un.)</td>
                                                        <td>
                                                            <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => DeleteCargoAsync(truck.Id, cargo)">
                                                                Excluir
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div class="text-secondary">Nenhum item de carga cadastrado para este caminhão.</div>
                                    }

                                    <div class="d-flex justify-content-end mt-3">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTruckAsync(truck)">Excluir caminhão</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<TruckDto> trucks = [];
    private readonly Dictionary<int, CargoForm> truckCargoForms = [];
    private readonly HashSet<int> openTruckIds = [];
    private bool isLoading;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTrucksAsync();
    }

    private async Task LoadTrucksAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var response = await http.GetFromJsonAsync<List<TruckDto>>("/api/trucks/");
            trucks.Clear();
            if (response is not null)
            {
                trucks.AddRange(response);
            }
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleTruck(int truckId)
    {
        if (!openTruckIds.Remove(truckId))
        {
            openTruckIds.Add(truckId);
        }
    }

    private async Task HandleCreateCargoAsync(int truckId)
    {
        var cargoForm = GetCargoForm(truckId);
        isSubmitting = true;
        errorMessage = null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var payload = new
            {
                Name = cargoForm.Name,
                LengthCm = cargoForm.LengthCm,
                WidthCm = cargoForm.WidthCm,
                HeightCm = cargoForm.HeightCm,
                WeightKg = cargoForm.WeightKg,
                Quantity = cargoForm.Quantity
            };

            var response = await http.PostAsJsonAsync($"/api/trucks/{truckId}/cargo", payload);
            await ApiException.EnsureSuccessAsync(response);

            cargoForm.Reset();
            await LoadTrucksAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private CargoForm GetCargoForm(int truckId)
    {
        if (!truckCargoForms.TryGetValue(truckId, out var form))
        {
            form = new CargoForm();
            truckCargoForms[truckId] = form;
        }

        return form;
    }

    private async Task DeleteTruckAsync(TruckDto truck)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Excluir o caminhão {truck.Name} e toda a carga dele?"))
        {
            return;
        }

        await SendDeleteAsync($"/api/trucks/{truck.Id}");
    }

    private async Task DeleteCargoAsync(int truckId, CargoDto cargo)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Excluir o item {cargo.Name}?"))
        {
            return;
        }

        await SendDeleteAsync($"/api/trucks/{truckId}/cargo/{cargo.Id}");
    }

    private async Task SendDeleteAsync(string url)
    {
        errorMessage = null;

        try
        {
            using var http = HttpClientFactory.CreateClient("CubagemApi");
            var response = await http.DeleteAsync(url);
            await ApiException.EnsureSuccessAsync(response);

            await LoadTrucksAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = ApiException.ConnectionError;
        }
    }

    private decimal GetTotalVolumeM3() => trucks.Sum(t => t.CargoVolumeM3);

    private decimal GetAverageOccupancy() => trucks.Any() ? trucks.Average(t => t.OccupancyPercent) : 0m;

    // A situação vem pronta da API (OK, Atenção, Excede); aqui só escolhe a cor.
    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Excede" => "bg-danger",
        "Atenção" => "bg-warning text-dark",
        _ => "bg-success"
    };

    private sealed class CargoForm
    {
        public string? Name { get; set; }
        public decimal LengthCm { get; set; } = 100m;
        public decimal WidthCm { get; set; } = 100m;
        public decimal HeightCm { get; set; } = 100m;
        public decimal WeightKg { get; set; } = 10m;
        public int Quantity { get; set; } = 1;

        public void Reset()
        {
            Name = string.Empty;
            LengthCm = 100m;
            WidthCm = 100m;
            HeightCm = 100m;
            WeightKg = 10m;
            Quantity = 1;
        }
    }
}
