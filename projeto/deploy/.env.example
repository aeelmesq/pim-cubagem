# Copie para deploy/.env (fica fora do Git) e troque as senhas.
VPS_HOST=191.252.184.167
NGINX_HOST=191-252-184-167.sslip.io

# Usuário e senha que o navegador pede para abrir o site.
BASIC_AUTH_USER=pim
BASIC_AUTH_PASSWORD=Troque-esta-senha

# Usuário do banco só para a API (criado pelo deploy/criar-usuario-banco.sh).
DB_USER=cubagem_api
DB_PASSWORD=Troque-esta-senha-1

# Chave que assina o JWT do login dos motoristas (pelo menos 32 caracteres).
# Gere uma com: openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Login do administrador nas telas de cadastro do site (Início, Caminhões, Motoristas, Histórico).
ADMIN_USER=admin
ADMIN_PASSWORD=Troque-esta-senha-2
